material {
    name : Toon,
    shadingModel : lit,
    parameters : [
        {
            type : float4,
            name : baseColor
        }
    ],
    customSurfaceShading : true
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = materialParams.baseColor;
    }

    vec3 surfaceShading(
            const MaterialInputs materialInputs,
            const ShadingData shadingData,
            const LightData lightData
    ) {
        vec3 normal = getWorldNormalVector();

        float up    = max(dot(normal, vec3( 0.0,  1.0,  0.0)), 0.0);
        float down  = max(dot(normal, vec3( 0.0, -1.0,  0.0)), 0.0);
        float north = max(dot(normal, vec3( 0.0,  0.0, -1.0)), 0.0);
        float south = max(dot(normal, vec3( 0.0,  0.0,  1.0)), 0.0);
        float east  = max(dot(normal, vec3( 1.0,  0.0,  0.0)), 0.0);
        float west  = max(dot(normal, vec3(-1.0,  0.0,  0.0)), 0.0);

        vec3 color = shadingData.diffuseColor;

        color = mix(color, shadingData.diffuseColor * 1.00, up);
        color = mix(color, shadingData.diffuseColor * 1.00, down);
        color = mix(color, shadingData.diffuseColor * 0.70, north);
        color = mix(color, shadingData.diffuseColor * 0.50, south);
        color = mix(color, shadingData.diffuseColor * 0.85, east);
        color = mix(color, shadingData.diffuseColor * 0.60, west);

        const float shades   = 4.0;
        const float ambient  = 0.20;
        const float minLight = 0.20;
        const float maxLight = 0.60;

        float NdotLCompressed = mix(minLight, maxLight, lightData.NdotL);

        float toon = max(ceil(NdotLCompressed * shades) / shades, ambient);
        toon *= lightData.visibility * lightData.attenuation;

        float intensity = min(lightData.colorIntensity.w, 1.0);

        vec3 light = lightData.colorIntensity.rgb * intensity;

        float shade = 0.50;

        shade = mix(shade, 1.00, up);
        shade = mix(shade, 0.15, down);
        shade = mix(shade, 0.70, north);
        shade = mix(shade, 0.45, south);
        shade = mix(shade, 0.85, east);
        shade = mix(shade, 0.60, west);

        //return color * light * toon;
        return color * shade;
    }
}